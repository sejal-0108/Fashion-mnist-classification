 # **Import Libraries**


import numpy as np
import matplotlib.pyplot as plt


import seaborn as sns
import tensorflow as tf


pip install keras

import keras

 **Load Data**

(train_images,train_labels),(test_images,test_labels)=keras.datasets.fashion_mnist.load_data()

# **Explore data**

**Shape of Data**

train_images.shape, train_labels.shape, test_images.shape,test_labels.shape

Image data in 2d numpy array shape 28*28 pixels

Pixels values ranging from 0 - 255

train_images[0]

train_labels[0]

# **Product Labels**

**Label the product array of index 0 - 9**

product_labels = ["T-shirt/top","Trouser","Pullover","Dress","Coat","Sandal","Shirt","Sneaker","Bag","Ankle boot"]

**check the product labels**


for i in range(10):
  print(f"{i}: {product_labels[i]}")

**Show image**

plt.figure()
plt.imshow(train_images[0])
plt.colorbar()
plt.grid(False)
plt.show()

plt.figure(figsize=(10,10))

j=1
for i in np.random.randint(0, 1000, 25):
  plt.subplot(5,5,j); j+=1
  plt.xticks([])
  plt.yticks([])
  plt.imshow(train_images[i], cmap="Greys")
  plt.title('{} / {}'.format(product_labels[train_labels[i]], train_labels[i]))

**Change the Dimension**

train_images.shape

train_images.ndim

 - **Expected conv2d_input to have 4 dimensions, but got array with shape (28, 28, 1)**
 - **so we have increase the dimention 3 to 4**

train_images = np.expand_dims(train_images, -1)
test_images = np.expand_dims(test_images, -1)

train_images.ndim

# **Feature Scaling**

   -Scale these value range 0 to 1 before feeding them to Neural Network Model.
   
   -Divide the values by 255


train_images=train_images/255.0
test_images=test_images/255.0

# **Split Dataset**

from sklearn.model_selection import train_test_split

train_images, image_validation, train_labels, label_validation = train_test_split(train_images, train_labels, test_size= 0.2, random_state=2020)

train_images.shape, train_labels.shape, image_validation.shape, label_validation.shape

# **Convolutional Neural Network**

**Build the Model**

cnn_model = keras.models.Sequential([
                         keras.layers.Conv2D(filters=32, kernel_size=3, strides=(1,1), padding='valid',activation= 'relu', input_shape=[28,28,1]),
                         keras.layers.MaxPooling2D(pool_size=(2,2)),
                         keras.layers.Flatten(),
                         keras.layers.Dense(units=128, activation='relu'),
                         keras.layers.Dense(units=10, activation='softmax')
])

cnn_model.summary()

**compile the build**

cnn_model.compile(optimizer='adam', loss= 'sparse_categorical_crossentropy', metrics=['accuracy'])

**train the cnn model**

cnn_model.fit(train_images, train_labels,
              epochs=10, batch_size=512, verbose=1,
              validation_data=(image_validation, label_validation))

**Test the model**

label_pred=cnn_model.predict(test_images)

label_pred

label_pred.round(2)

test_labels

cnn_model.evaluate(test_images, test_labels)

# **Visualize Output**

plt.figure(figsize=(15,36))
j=1
for i in np.random.randint(0, 1000,60):
    plt.subplot(10,6, j); j+=1
    plt.xticks([])
    plt.yticks([])
    plt.imshow(test_images[i].reshape(28,28), cmap='Greens')
    plt.title('Actual = {} / {} \nPredicted = {} / {}'.format(product_labels[test_labels[i]],test_labels[i], product_labels[np.argmax(label_pred[i])], np.argmax(label_pred[i])))


**Confusion Matrix**

from sklearn.metrics import confusion_matrix

plt.figure(figsize=(14,7))
predict_label_pred = [np.argmax(label) for label in label_pred]
cm = confusion_matrix(test_labels, predict_label_pred)
sns.heatmap(cm, annot=True, fmt='d', xticklabels=product_labels, yticklabels=product_labels)

from sklearn.metrics import classification_report

cr = classification_report(test_labels, predict_label_pred, target_names=product_labels)
print(cr)

# **Save Model**

cnn_model.save('m1.h5')

